      "activate"
    ],
    "fields": [
      "slug",
      "activate"
    ]
  },
  "mcp_update_plugin": {
    "method": "POST",
    "route": "/mcp/v1/plugins/update",
    "source": "cvrt-mcp-endpoints 1.16.0 class-plugins-endpoint.php update_plugin (args plugin, refresh)",
